{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "singleQuote": true,
  "trailingComma": "all",
  "printWidth": 100,
  "semi": true,
  "tabWidth": 2,
  "useTabs": false,
  "ignorePatterns": [
    "node_modules",
    "dist",
    "coverage",
    ".vitest",
    ".nyc_output",
    "*.log"
  ]
}
